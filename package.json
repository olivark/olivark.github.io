{
  "name": "kevin-olivar-site",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "search:index": "pagefind --site _site",
    "format": "prettier --write assets/*.js assets/*.css scripts/*.mjs tests/*.cjs *.cjs *.json _config.yml .github/workflows/*.yml",
    "format:check": "prettier --check assets/*.js assets/*.css scripts/*.mjs tests/*.cjs *.cjs *.json _config.yml .github/workflows/*.yml",
    "test": "npm run build:production && playwright test",
    "check": "npm run format:check && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.6"
  }
}
